# Plantilla para desarrollo local -- copiá este archivo a ".env" (mismo
# directorio, back/) y ajustá lo que haga falta. ".env" nunca se commitea
# (ver back/.gitignore) -- ESTE archivo sí, es la única referencia versionada
# de qué variables hacen falta y con qué formato.
#
# Cómo usarlo (PowerShell, desde back/):
#   Copy-Item .env.example .env
# y después editar .env con tus propios valores.

# Base de datos -- AJUSTÁ usuario/password/puerto/nombre según tu Postgres
# local. Si no existe todavía la base "novabyte_demo", hay que crearla antes.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/novabyte_demo

# CORS: el frontend en desarrollo corre en localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000

# JWT -- generá el tuyo propio, NUNCA reuses uno que hayas visto en un
# ejemplo o en el historial de git.
#
# HALLAZGO (18/09/2026): una versión anterior de esta plantilla
# ("Claude outputs/back.env") traía una SECRET_KEY ya generada de fábrica
# -- mala práctica: terminó pusheada sin querer a este repo público. Esta
# plantilla ya no repite ese error; generá la tuya con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generá-la-tuya-con-el-comando-de-arriba-nunca-uses-este-valor
ALGORITHM=HS256

# Mercado Pago -- PLACEHOLDERS: el backend arranca y podés navegar el sitio,
# pero el botón de pagar va a fallar (no son credenciales reales). Para que
# el checkout funcione de verdad, reemplazá por un access token y un
# webhook secret de PRUEBA de tu cuenta de Mercado Pago (Developers > Tus
# integraciones > Credenciales de prueba).
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=placeholder-webhook-secret
MP_SUCCESS_URL=http://localhost:3000/pago/exito
MP_FAILURE_URL=http://localhost:3000/pago/error
MP_PENDING_URL=http://localhost:3000/pago/pendiente
API_PUBLIC_BASE_URL=http://localhost:8000

# Mail saliente (códigos de verificación) -- PLACEHOLDER: el backend arranca,
# pero enviar mails va a fallar (no es una cuenta real). Para que funcione,
# reemplazá por una cuenta de Gmail con verificación en 2 pasos y una
# "contraseña de aplicación" (ver comentario en app/core/config.py).
SMTP_USER=demo@example.com
SMTP_PASSWORD=placeholder
SMTP_FROM_NAME=NovaByte
